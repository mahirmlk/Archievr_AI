generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  roadmaps      Roadmap[]
  progress      Progress[]
  resources     Resource[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Roadmap {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean      @default(false)
  isEditable  Boolean      @default(true)
  phases      Phase[]      @relation("RoadmapPhases")
  topProjects TopProject[] @relation("RoadmapTopProjects")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Phase {
  id          String   @id @default(cuid())
  roadmapId   String
  order       Int
  title       String
  description String?
  duration    String?
  topics      Topic[]  @relation("PhaseTopics")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roadmap     Roadmap  @relation("RoadmapPhases", fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model Topic {
  id          String     @id @default(cuid())
  phaseId     String
  order       Int
  title       String
  description String?
  skills      String[]
  projects    Project[]  @relation("TopicProjects")
  resources   Resource[] @relation("TopicResources")
  progress    Progress[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  phase       Phase      @relation("PhaseTopics", fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

model Project {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  description String
  difficulty  String
  isPortfolio Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation("TopicProjects", fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model TopProject {
  id          String   @id @default(cuid())
  roadmapId   String
  title       String
  description String
  tech        String[]
  impact      String?
  difficulty  String
  isPortfolio Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roadmap     Roadmap  @relation("RoadmapTopProjects", fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model Resource {
  id          String    @id @default(cuid())
  userId      String
  topicId     String?
  title       String
  type        String
  url         String?
  content     String?   @db.Text
  fileUrl     String?
  tags        String[]
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic?    @relation("TopicResources", fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
}

model Progress {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  status         String
  completionRate Float    @default(0)
  notes          String?  @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}
